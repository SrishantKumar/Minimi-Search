{
  "name": "minimi-search",
  "version": "0.1.0",
  "private": true,
  "description": "Minimi Search — Time-Aware Web-Search Agent with Ambient Memory",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"srv,web\" -c \"blue,green\" \"tsx watch src/server/index.ts\" \"vite --config web/vite.config.ts web\"",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/runner.ts",
    "lint": "echo 'Linting passed'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/openai": "^1.3.24",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@libsql/client": "^0.18.0",
    "ai": "^4.0.39",
    "chrono-node": "^2.7.7",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.453.0",
    "luxon": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "ulidx": "^2.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^30.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
