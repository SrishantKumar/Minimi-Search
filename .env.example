# --- LLM (use whichever provider you have a key for; set tiers below) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_FAST=google:gemini-3.1-flash-lite
LLM_MAIN=google:gemini-3.5-flash-lite
LLM_FALLBACK=google:gemini-3.1-flash-lite
EMBEDDING_MODEL=google:text-embedding-004
EMBEDDING_DIM=768
WORKER_POOL_SIZE=2

# --- Search ---
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
SEARCH_PROVIDER_ORDER=tavily,exa

# --- App ---
PORT=8787
DATABASE_PATH=./data/chronos.db
COOKIE_SECRET=chronos-dev-secret-key-32-chars-min
DEFAULT_TZ=UTC
SEARCH_CACHE_TTL_VOLATILE_MIN=360
LOG_LEVEL=info
EVAL_SEARCH_MODE=replay

